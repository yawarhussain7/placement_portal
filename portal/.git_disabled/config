[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/yawarhussain7/portal.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "feature/profile"]
	remote = origin
	merge = refs/heads/feature/profile
[branch "feature/setting"]
	remote = origin
	merge = refs/heads/feature/setting
	vscode-merge-base = origin/feature/profile
